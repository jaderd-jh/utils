{
  "name": "@jhqn/utils-storage",
  "version": "0.6.0",
  "keywords": [
    "jade",
    "utils"
  ],
  "homepage": "https://github.com/jaderd-jh/utils/tree/main/packages/storage#readme",
  "bugs": {
    "url": "https://github.com/jaderd-jh/utils/issues"
  },
  "license": "MIT",
  "author": "jade-gjz <jiangang.zhang@jaderd.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaderd-jh/utils.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      }
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run -p e2e",
    "test:e2e:watch": "vitest -p e2e",
    "test:unit": "vitest run -p unit",
    "test:unit:watch": "vitest -p unit",
    "build": "tsdown",
    "publint": "publint"
  },
  "dependencies": {
    "@jhqn/utils-core": "workspace:*",
    "@jhqn/utils-crypto": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "catalog:",
    "jotai": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest-browser-react": "^2.3.0",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@vueuse/core": "^15.0.0",
    "jotai": "^3.0.0",
    "vue": "^3.5.22"
  },
  "peerDependenciesMeta": {
    "@vueuse/core": {
      "optional": true
    },
    "jotai": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
